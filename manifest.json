{
  "manifest_version": 3,
  "name": "LinkedIn Saved Posts Exporter (Local)",
  "version": "1.5.0",
  "description": "Export your saved LinkedIn posts to CSV or JSON locally, with resumable scanning, a configurable limit and quality checks.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Saved Posts Exporter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}